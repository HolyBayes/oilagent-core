FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends libseccomp2 \
    && rm -rf /var/lib/apt/lists/*
COPY runner/requirements.lock /worker/requirements.lock
RUN pip install --no-cache-dir -r /worker/requirements.lock
COPY runner/*.py /worker/
RUN mkdir -p /jail/tmp /jail/worker /jail/etc \
    && cp -al /usr /jail/usr \
    && ln -s usr/lib /jail/lib \
    && ln -s usr/lib64 /jail/lib64 \
    && cp /etc/ld.so.cache /jail/etc/ \
    && cp /worker/worker.py /jail/worker/
WORKDIR /worker
ENV PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["python", "service.py"]
