# Integration prototype. No private banking data.
LLM_PROVIDER=gigachat
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_CA_BUNDLE_FILE=
# Alternative provider: LLM_PROVIDER=openai
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SEC=20
# Empty / unset / None: do not send an application output limit to the provider.
LLM_MAX_OUTPUT_TOKENS=
LLM_STRUCTURED_METHOD=function_calling
# Local OpenAI-compatible endpoint example (must support selected structured method):
# LLM_PROVIDER=local
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=your-installed-model
# LLM_API_KEY=  # optional for local, required for openai profile
# Different secrets for the two services; no secrets belong in committed JSON.
ANALYST_MCP_TOKEN=
EVOLUTION_MCP_TOKEN=
WORKSPACE_PATH=workspace/runtime
OUROBOROS_PATH=../workspace/upstream/ouroboros

# Independent sibling Git repository; never inside the core checkout.
EVOLUTION_REPO_PATH=../evolution

# Public PDF corpus and local embeddings; relative paths start at core/.
REPORT_MANIFEST_PATH=data/reports.json
USER_FILES_PATH=workspace/files
REPORTS_PATH=workspace/files/OilAgent/Reports
RAG_INDEX_PATH=workspace/rag
EMBEDDING_CACHE_PATH=workspace/files/OilAgent/Models
RAG_TOP_K=4
# Independent HyDE model; cache misses make one extra LLM call.
RAG_HYDE_ENABLED=true
RAG_HYDE_PROVIDER=gigachat
RAG_HYDE_MODEL=GigaChat-2
# Free DuckDuckGo search via DDGS; no API key.
WEB_ENABLED=true

# Persistent daily history; fetch only missing date intervals (no TTL).
BRENT_CACHE_PATH=workspace/files/OilAgent/Prices
# Optional offline CSV override with adjacent JSON provenance/hash; disables downloads.
BRENT_DATA_PATH=

# Dialogue context and replayable request traces.
SESSION_DB_PATH=workspace/sessions.sqlite3
TRACE_PATH=workspace/traces
TRACE_RETENTION_DAYS=7
RELEASE_PATH=workspace/releases
# Fixed operator-owned evaluation; never mount it in the author container.
SKILL_EVAL_PATH=data/skill_eval.json
EVOLUTION_EVAL_PATH=data/evolution_eval.json
EVOLUTION_MIN_GAIN=0.01
# Admission budgets; output tokens are unrestricted unless explicitly configured above.
REQUEST_TIMEOUT_SEC=120
REQUEST_MAX_LLM_CALLS=4
REQUEST_MAX_TOOLS=6
REQUEST_MAX_INPUT_BYTES=96000
REQUEST_MAX_INPUT_TOKENS=24000
# Optional monetary admission reservation requires actual prices AND explicit output bound.
REQUEST_MAX_COST=0
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
LLM_PRICE_CURRENCY=RUB
WEB_MAX_AGE_DAYS=7
QUOTE_MAX_AGE_SEC=345600
# Shared admission slot prevents concurrent GigaChat calls from these processes.
LLM_LOCK_PATH=workspace/llm/gigachat.lock
EVOLUTION_MAX_CANDIDATES=2

# Optional shared Codex model backend through native Ouroboros (requires UI login).
OUROBOROS_LLM_BRIDGE_ENABLED=false
LLM_BRIDGE_TOKEN=

# Private numerical executor; never mount Docker in author or analytical services.
RUNNER_URL=http://127.0.0.1:8813
RUNNER_TOKEN=
RUNNER_PORT=8813

# Native UI used for backend skill authorization; default uses localhost/UI_PORT.
# Compose sets http://ouroboros:8765 automatically.
NATIVE_UI_URL=

# Paid native-review waves per package snapshot; may be raised after a failed dispatch.
OUROBOROS_REVIEW_MAX_CYCLES=1
